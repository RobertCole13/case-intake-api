{
  "name": "case-intake-api",
  "version": "1.0.0",
  "private": true,
  "description": "Case intake API for a financial regulator examination program.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "pretest": "node -e \"require('fs').rmSync('prisma/dev.db',{force:true});require('fs').rmSync('prisma/dev.db-journal',{force:true})\" && prisma db push --skip-generate && ts-node prisma/seed.ts",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "evidence": "ts-node scripts/evidence.ts",
    "playwright:install": "playwright install chromium",
    "control": "node scripts/control.js",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/node": "^22.18.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "playwright": "^1.64.1",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
